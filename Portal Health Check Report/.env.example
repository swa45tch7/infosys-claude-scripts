# Copy this file to ".env" in this folder and fill in the three values.
# Never share or commit the .env file.
# Create the token in LogicMonitor: Settings > Users and Roles > API Tokens (see README.md, step 3).

# Portal prefix only: for https://acme.logicmonitor.com use acme
LM_ACCOUNT=
LM_ACCESS_ID=
LM_ACCESS_KEY=

# Optional. Only change for portals not on logicmonitor.com
# LM_DOMAIN=logicmonitor.com
