<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dataSource>
  <name>Docker_Linux_Containers</name>
  <displayName>Docker Linux Containers</displayName>
  <description>Container instances on already-monitored Linux Docker hosts. Active Discovery runs lm_docker_container_monitor.sh discover. Collection runs lm_docker_container_monitor.sh collect.</description>
  <appliesTo>hasCategory("docker") &amp;&amp; isLinux()</appliesTo>
  <group>Docker</group>
  <tags>docker,containers</tags>
  <technology>Put lm_docker_container_monitor.sh on the Collector at ##AGENTROOT##/local/bin/. Import this XML. Apply to already-monitored Linux Docker hosts. Active Discovery: discover. Collection: collect.</technology>
  <collectMethod>batchscript</collectMethod>
  <collectInterval>60</collectInterval>
  <hasMultiInstances>true</hasMultiInstances>
  <enableAutoDiscovery>true</enableAutoDiscovery>
  <useWildValueAsUUID>true</useWildValueAsUUID>
  <collectorAttribute>
    <name>batchscript</name>
    <scriptType>file</scriptType>
    <linuxScript>##AGENTROOT##/local/bin/lm_docker_container_monitor.sh</linuxScript>
    <linuxCmdline>collect</linuxCmdline>
  </collectorAttribute>
  <autoDiscoveryConfig>
    <persistentInstance>true</persistentInstance>
    <scheduleInterval>15</scheduleInterval>
    <deleteInactiveInstance>true</deleteInactiveInstance>
    <disableInstance>false</disableInstance>
    <instanceAutoGroupMethod>none</instanceAutoGroupMethod>
    <method>
      <name>ad_script</name>
      <type>file</type>
      <linuxScript>##AGENTROOT##/local/bin/lm_docker_container_monitor.sh</linuxScript>
      <linuxCmdline>discover</linuxCmdline>
    </method>
  </autoDiscoveryConfig>
  <dataPoints>
  <dataPoint>
    <name>running</name>
    <description>1 if the container is running, else 0</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.running</postProcessorParam>
    <rawDataFieldName>output</rawDataFieldName>
    <alertForNoData>1</alertForNoData>
    <alertExpr>&lt; 1 1 1</alertExpr>
    <minValue>0</minValue>
    <maxValue>1</maxValue>
    <alertTransitionInterval>1</alertTransitionInterval>
    <alertClearTransitionInterval>0</alertClearTransitionInterval>
  </dataPoint>
  <dataPoint>
    <name>paused</name>
    <description>1 if the container is paused, else 0</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.paused</postProcessorParam>
    <rawDataFieldName>output</rawDataFieldName>
    <alertForNoData>1</alertForNoData>
    <alertExpr></alertExpr>
    <minValue>0</minValue>
    <maxValue>1</maxValue>
    <alertTransitionInterval>0</alertTransitionInterval>
    <alertClearTransitionInterval>0</alertClearTransitionInterval>
  </dataPoint>
  <dataPoint>
    <name>restarting</name>
    <description>1 if the container is restarting, else 0</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.restarting</postProcessorParam>
    <rawDataFieldName>output</rawDataFieldName>
    <alertForNoData>1</alertForNoData>
    <alertExpr></alertExpr>
    <minValue>0</minValue>
    <maxValue>1</maxValue>
    <alertTransitionInterval>0</alertTransitionInterval>
    <alertClearTransitionInterval>0</alertClearTransitionInterval>
  </dataPoint>
  <dataPoint>
    <name>oomKilled</name>
    <description>1 if the container was killed by the OOM killer, else 0</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.oomKilled</postProcessorParam>
    <rawDataFieldName>output</rawDataFieldName>
    <alertForNoData>1</alertForNoData>
    <alertExpr></alertExpr>
    <minValue>0</minValue>
    <maxValue>1</maxValue>
    <alertTransitionInterval>0</alertTransitionInterval>
    <alertClearTransitionInterval>0</alertClearTransitionInterval>
  </dataPoint>
  <dataPoint>
    <name>healthStatus</name>
    <description>Docker health: 0=unhealthy, 1=healthy, 2=starting, 3=no health check</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.healthStatus</postProcessorParam>
    <rawDataFieldName>output</rawDataFieldName>
    <alertForNoData>1</alertForNoData>
    <alertExpr></alertExpr>
    <minValue>0</minValue>
    <maxValue>3</maxValue>
    <alertTransitionInterval>0</alertTransitionInterval>
    <alertClearTransitionInterval>0</alertClearTransitionInterval>
  </dataPoint>
  <dataPoint>
    <name>healthFailingStreak</name>
    <description>Consecutive failed Docker health-check probes</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.healthFailingStreak</postProcessorParam>
