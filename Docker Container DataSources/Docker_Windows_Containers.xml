<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dataSource>
  <name>Docker_Windows_Containers</name>
  <displayName>Docker Windows Containers</displayName>
  <description>Container instances on already-monitored Windows Docker hosts. Active Discovery runs lm_docker_container_monitor.ps1 -Mode discover. Collection runs lm_docker_container_monitor.ps1 -Mode collect.</description>
  <appliesTo>hasCategory("docker") &amp;&amp; isWindows()</appliesTo>
  <group>Docker</group>
  <tags>docker,containers</tags>
  <technology>Put lm_docker_container_monitor.ps1 on the Collector at ##AGENTROOT##/local/bin/. Import this XML. Apply to already-monitored Windows Docker hosts. Active Discovery: -Mode discover. Collection: -Mode collect.</technology>
  <collectMethod>batchscript</collectMethod>
  <collectInterval>60</collectInterval>
  <hasMultiInstances>true</hasMultiInstances>
  <enableAutoDiscovery>true</enableAutoDiscovery>
  <useWildValueAsUUID>true</useWildValueAsUUID>
  <collectorAttribute>
    <name>batchscript</name>
    <scriptType>file</scriptType>
    <windowsScript>##AGENTROOT##/local/bin/lm_docker_container_monitor.ps1</windowsScript>
    <windowsCmdline>-Mode collect</windowsCmdline>
  </collectorAttribute>
  <autoDiscoveryConfig>
    <persistentInstance>true</persistentInstance>
    <scheduleInterval>15</scheduleInterval>
    <deleteInactiveInstance>true</deleteInactiveInstance>
    <disableInstance>false</disableInstance>
    <instanceAutoGroupMethod>none</instanceAutoGroupMethod>
    <method>
      <name>ad_script</name>
      <type>file</type>
      <winScript>##AGENTROOT##/local/bin/lm_docker_container_monitor.ps1</winScript>
      <winCmdline>-Mode discover</winCmdline>
    </method>
  </autoDiscoveryConfig>
  <dataPoints>
  <dataPoint>
    <name>containerPresent</name>
    <description>1 if docker inspect succeeded for this instance this poll</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.containerPresent</postProcessorParam>
    <rawDataFieldName>output</rawDataFieldName>
    <alertForNoData>1</alertForNoData>
    <alertExpr></alertExpr>
    <minValue>0</minValue>
    <maxValue>1</maxValue>
    <alertTransitionInterval>0</alertTransitionInterval>
    <alertClearTransitionInterval>0</alertClearTransitionInterval>
  </dataPoint>
  <dataPoint>
    <name>running</name>
    <description>1 if the container is running, else 0</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.running</postProcessorParam>
    <rawDataFieldName>output</rawDataFieldName>
    <alertForNoData>1</alertForNoData>
    <alertExpr>&lt; 1 1 1</alertExpr>
    <minValue>0</minValue>
    <maxValue>1</maxValue>
    <alertTransitionInterval>1</alertTransitionInterval>
    <alertClearTransitionInterval>0</alertClearTransitionInterval>
  </dataPoint>
  <dataPoint>
    <name>paused</name>
    <description>1 if the container is paused, else 0</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.paused</postProcessorParam>
    <rawDataFieldName>output</rawDataFieldName>
    <alertForNoData>1</alertForNoData>
    <alertExpr></alertExpr>
    <minValue>0</minValue>
    <maxValue>1</maxValue>
    <alertTransitionInterval>0</alertTransitionInterval>
    <alertClearTransitionInterval>0</alertClearTransitionInterval>
  </dataPoint>
  <dataPoint>
    <name>restarting</name>
    <description>1 if the container is restarting, else 0</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
    <postProcessorParam>##WILDVALUE##.restarting</postProcessorParam>
    <rawDataFieldName>output</rawDataFieldName>
    <alertForNoData>1</alertForNoData>
    <alertExpr></alertExpr>
    <minValue>0</minValue>
    <maxValue>1</maxValue>
    <alertTransitionInterval>0</alertTransitionInterval>
    <alertClearTransitionInterval>0</alertClearTransitionInterval>
  </dataPoint>
  <dataPoint>
    <name>oomKilled</name>
    <description>1 if the container was killed by the OOM killer, else 0</description>
    <dataType>7</dataType>
    <type>2</type>
    <postProcessorMethod>namevalue</postProcessorMethod>
